# Copy to .env (for docker compose) or server/.env (for `npm run dev`) and fill in.

# Required: long random string used to sign JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=

# PostgreSQL connection. docker compose provides its own database, so only set this for `npm run dev`.
# DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger

# Comma-separated list of frontend origins allowed to call the API with cookies.
FRONTEND_URL=http://localhost:3000

# Public URL of the API (used for links to locally stored uploads) and the URL the browser uses to reach it.
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Cloudinary for media storage. Leave empty to store uploads on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
